# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/smartspace_db

# JWT Security Secrets (Use long, random strings in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Token Expirations
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Rate Limiting Configuration (supports '10m', '15m', '1h', '1d', etc.)
RATE_LIMIT_GENERAL_WINDOW=10m
RATE_LIMIT_GENERAL_MAX=100

RATE_LIMIT_AUTH_WINDOW=15m
RATE_LIMIT_AUTH_MAX=10

RATE_LIMIT_AI_WINDOW=30m
RATE_LIMIT_AI_MAX=5

RATE_LIMIT_CONTACT_WINDOW=1h
RATE_LIMIT_CONTACT_MAX=5

# Client Configuration
CLIENT_URL=http://localhost:5173

# Stripe Credentials
STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_SECRET_KEY=your_stripe_secret_key

#https://smartspaceai.me/api/billing/webhook
STRIPE_WEBHOOK_KEY=your_stripe_webhook_key

#Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_FOR_GUARD=gemini-3.1-flash-lite
GEMINI_MODEL_FOR_JSON_CONVERSION=gemini-3.1-flash-lite
GEMINI_MODEL_FOR_IMAGE_GEN=imagen-4.0-ultra-generate-001
AMAZON_MODEL_FOR_IMAGE_GEN=amazon.titan-image-generator-v2:0
AMAZON_API_KEY=your_amazon_api_key
QWEN_MODEL_FOR_IMAGE_GEN=qwen-image-2.0-pro
QWEN_API_KEY=your_qwen_api_key
GLM_API_KEY=your_glm_api_key
POLLEN_API_KEY=your_pollen_api_key

# Email (Gmail SMTP) Configuration
# For Gmail, generate an App Password from your Google Account security page (2-Step Verification required)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smartspaceai8@gmail.com
SMTP_PASS=rqlx bjuh snoz lifa
EMAIL_FROM="SmartSpace AI smartspaceai8@gmail.com"

# OAuth credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo